+#include "..\..\Minecraft.World\FLCE_Hooks.h" // ForgedLCE
+
 LPCWSTR	CConsoleMinecraftApp::GetString(int iID)
 { 
+	// ForgedLCE: names of mod blocks and items. The Xbox 360 looks strings up
+	// in its XUI string table instead of the shared StringTable (patch 0007).
+	if (iID >= ForgedLCE::STRING_ID_BASE)
+	{
+		LPCWSTR modString = ForgedLCE::GetModString(iID);
+		return modString != NULL ? modString : L"";
+	}
+
 	return StringTable.Lookup(iID);
 }
 
