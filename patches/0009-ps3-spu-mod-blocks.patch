 	CREATE_TILE_TYPE(stairs_quartz_Id, StairTile_SPU);
  	CREATE_TILE_TYPE(woolCarpet_Id, WoolCarpetTile_SPU);
 
+	// ForgedLCE: block ids with no SPU class above (mod blocks) get the generic
+	// Tile_SPU, which draws a plain block from the per-id data the PPU fills in
+	// for every existing tile (icon, shape, material, light). Without this,
+	// createFromID() draws unknown ids as stone.
+	for (int i = 1; i < 256; i++)
+	{
+		if (m_tiles[i].id == -1)
